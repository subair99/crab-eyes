# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Confirm the base URL in your Token Factory console.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily
TAVILY_API_KEY=

# Postgres (docker-compose starts one on localhost:5432)
DATABASE_URL=postgresql+psycopg://crab:crab@localhost:5432/crabeyes

# Telegram (optional; only if you build the bot)
TELEGRAM_BOT_TOKEN=
CRAB_EYES_API_URL=http://localhost:8000

# Benchmark for the Ponzi maths: current Nigerian T-bill yield as a decimal (e.g. 0.20 = 20% a year).
# Set it from a live source on the day you run; rates.py can refresh it via Tavily.
BENCHMARK_ANNUAL_RATE=

# Optional: limit every Tavily search to pages published before this date (YYYY-MM-DD). Used by the CBEX re-run.
EVIDENCE_END_DATE=
